# =============================================================================
# Единственный шаблон окружения для docker compose (локальная разработка и прод).
#
#   cd infrastructure/docker
#   cp .env.example .env
#   nano .env   # секреты и прод-URL
#
#   docker compose --env-file .env -f docker-compose.yml up -d
#
# Перечислены только переменные, которые docker-compose.yml подставляет как ${VAR}
# (или передаёт в сервисы из этого файла через --env-file). Остальное задано в compose.
# Пароль POSTGRES_PASSWORD: без символов @ : / ? # в значении (ломают URL в compose).
# =============================================================================

# Имя проекта Docker (префикс томов: <имя>_postgres_data). На одном хосте — уникально.
COMPOSE_PROJECT_NAME=video_dgim_mos

# --- PostgreSQL (сервис db + DATABASE_URL во всех сервисах с БД) ---
POSTGRES_DB=video_hosting
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- auth-service ---
SECRET_KEY=your-secret-key-change-in-production
INTERNAL_AUTH_TOKEN=internal-secret-token
ALLOW_REGISTRATION=false
CORS_ORIGINS=
LDAP_SERVER=
LDAP_BASE_DN=DC=dgi,DC=mos,DC=ru

# --- MinIO (minio, minio-init, ключи S3 в video-service / celery-worker) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- video-service: медиа для браузера ---
# Dev: HLS через API (без CORS MinIO). Prod: можно false + nginx/MinIO CDN.
PUBLIC_VIDEO_API_URL=http://localhost:8001
PUBLIC_MEDIA_VIA_API=true
MINIO_EXTERNAL_ENDPOINT=localhost:9000

# --- streaming-service: ссылки в API для плеера и OBS ---
PUBLIC_HLS_BASE=http://localhost:8888
PUBLIC_RTMP_HOST=localhost

# --- notification-service ---
SMTP_SERVER=smtp.dgi.mos.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@video.dgi.mos.ru

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Сборка образа portal (куда Next проксирует /api/auth внутри Docker-сети) ---
AUTH_INTERNAL_URL=http://auth-service:8000

# =============================================================================
# Продакшен (раскомментируйте и подставьте свои значения)
# =============================================================================
# COMPOSE_PROJECT_NAME=video_prod_moscow
# POSTGRES_PASSWORD=...
# SECRET_KEY=...   # openssl rand -hex 32
# INTERNAL_AUTH_TOKEN=...
# MINIO_EXTERNAL_ENDPOINT=storage.example.ru
# CORS_ORIGINS=https://video.example.ru,https://portal.example.ru
# PUBLIC_HLS_BASE=https://video.example.ru/hls
# PUBLIC_RTMP_HOST=video.example.ru
# MINIO_ROOT_USER=...
# MINIO_ROOT_PASSWORD=...
# GRAFANA_ADMIN_PASSWORD=...

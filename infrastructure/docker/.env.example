# Database
POSTGRES_DB=video_hosting
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/video_hosting

# JWT
SECRET_KEY=your-secret-key-change-in-production
INTERNAL_AUTH_TOKEN=internal-secret-token

# Multi-Service Architecture
# Auth mode: 'standalone' for dev (local), 'shared' for production (external auth service)
AUTH_MODE=standalone
SERVICE_ID=video
SERVICE_NAME=Видеохостинг ДГИ
# SHARED_AUTH_URL=http://auth-service:8000  # Uncomment for shared mode (prod)

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=videos
MINIO_SECURE=false

# LDAP (for Active Directory integration)
LDAP_SERVER=
LDAP_BASE_DN=DC=dgi,DC=mos,DC=ru
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_INDEX=videos

# Email (for notifications)
SMTP_SERVER=smtp.dgi.mos.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@video.dgi.mos.ru

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8000
VIDEO_SERVICE_URL=http://video-service:8001
STREAMING_SERVICE_URL=http://streaming-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
SEARCH_SERVICE_URL=http://search-service:8004

# Upload settings
UPLOAD_EXPIRY_SECONDS=3600
SIGNED_URL_EXPIRY_SECONDS=3600
MAX_FILE_SIZE=10737418240

# Stream settings
RTMP_PORT=1935
RTMP_APP=live
HLS_SEGMENT_DURATION=2
HLS_PLAYLIST_LENGTH=10
DVR_MAX_DURATION=86400

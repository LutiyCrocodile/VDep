# Production Environment Configuration
# Copy to .env and fill in real values before deployment

# Database (Use strong password!)
POSTGRES_DB=video_hosting
POSTGRES_USER=video_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123
DATABASE_URL=postgresql+asyncpg://video_user:CHANGE_ME_STRONG_PASSWORD_123@db:5432/video_hosting

# JWT (Generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_32_BYTE_HEX_STRING
INTERNAL_AUTH_TOKEN=CHANGE_ME_UUID_OR_RANDOM_STRING

# Multi-Service Architecture (Production)
# In production, use shared auth service
AUTH_MODE=shared
SERVICE_ID=video
SERVICE_NAME=Видеохостинг ДГИ
SHARED_AUTH_URL=http://auth-service:8000

# MinIO (Use strong credentials!)
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=videos
MINIO_SECURE=true

# LDAP (Fill for Active Directory integration)
LDAP_SERVER=ldap://your-ldap-server.dgi.mos.ru
LDAP_BASE_DN=DC=dgi,DC=mos,DC=ru
LDAP_BIND_USER=CN=binduser,CN=Users,DC=dgi,DC=mos,DC=ru
LDAP_BIND_PASSWORD=CHANGE_ME_LDAP_PASSWORD

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_INDEX=videos

# Email (Fill with real SMTP credentials)
SMTP_SERVER=smtp.dgi.mos.ru
SMTP_PORT=587
SMTP_USERNAME=video-notifications@dgi.mos.ru
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=video-notifications@dgi.mos.ru

# Service URLs (Internal Docker network)
AUTH_SERVICE_URL=http://auth-service:8000
VIDEO_SERVICE_URL=http://video-service:8001
STREAMING_SERVICE_URL=http://streaming-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
SEARCH_SERVICE_URL=http://search-service:8004
MESSENGER_SERVICE_URL=http://messenger-service:3001
DASHBOARD_SERVICE_URL=http://dashboard-service:3003
SUPPORT_SERVICE_URL=http://support-service:3004

# Registration is disabled in production (users via LDAP only)
ALLOW_REGISTRATION=false

# Upload settings
UPLOAD_EXPIRY_SECONDS=3600
SIGNED_URL_EXPIRY_SECONDS=3600
MAX_FILE_SIZE=10737418240

# Stream settings
RTMP_PORT=1935
RTMP_APP=live
HLS_SEGMENT_DURATION=2
HLS_PLAYLIST_LENGTH=10
DVR_MAX_DURATION=86400

# Локальная разработка portal (npm run dev). Скопируйте:  cp .env.example .env.local
# Порт dev-сервера portal см. package.json (часто 3002).

NEXT_PUBLIC_AUTH_URL=http://localhost:8000
NEXT_PUBLIC_VIDEO_URL=http://localhost:3000
NEXT_PUBLIC_MESSENGER_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3003
NEXT_PUBLIC_SUPPORT_URL=http://localhost:3004
NEXT_PUBLIC_PORTAL_NAME=Портал ДГИ
NEXT_PUBLIC_COMPANY_NAME=Департамент городского имущества Москвы

# Rewrite /api/auth → auth-service (локально без Docker — 127.0.0.1:8000)
AUTH_INTERNAL_URL=http://127.0.0.1:8000

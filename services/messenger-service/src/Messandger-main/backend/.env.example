ENV=development

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/video_hosting
DB_SCHEMA=messenger
DB_ENCRYPTION_KEY=
DB_REQUIRE_TLS=false

AUTH_SERVICE_URL=http://localhost:8000
INTERNAL_AUTH_TOKEN=internal-secret-token
PORTAL_URL=http://localhost:3002

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

CORS_ORIGINS=http://localhost:3005,http://localhost:3002,http://localhost:3000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=30
